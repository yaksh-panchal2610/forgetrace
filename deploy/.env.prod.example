
APP_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/forgetrace:latest
DOMAIN=forgetrace-yourname.duckdns.org
AWS_REGION=ap-south-1

# --- Database (RDS endpoint from the AWS console) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT.ap-south-1.rds.amazonaws.com:5432/forgetrace?sslmode=require
SPRING_DATASOURCE_USERNAME=forgetrace_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Public URL (used in QR codes and email links) ---
APP_BASE_URL=https://forgetrace-yourname.duckdns.org
