ADMIN_EMAIL=admin@forgetrace.local
ADMIN_PASSWORD=change-me-now

# AWS (used in Step 12)
AWS_REGION=ap-south-1
S3_BUCKET=

# Payment sandbox - TEST keys only (used in Step 9)
PAYMENT_KEY_ID=
