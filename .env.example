# Copy this file to ".env" and change the values for your machine.
# NEVER commit the real .env file to GitHub.

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/forgetrace
DB_USERNAME=forgetrace
